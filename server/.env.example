# Never commit a real .env file.
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/kamk
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
OPENAI_API_KEY=sk-proj-your-server-side-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-before-deployment
CORS_ORIGINS=https://appassets.androidplatform.net

# Persistent storage mounted into the backend container
WORKBOOK_TEMPLATE_PATH=/data/kamk-hourly-observation-template.xlsx
REPORT_OUTPUT_DIR=/data/reports

# Telegram bot settings; keep these only in backend secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Enable the server-side scheduled report at minute 00 every two hours (Tashkent time)
REPORT_SCHEDULE_ENABLED=false
